# ==============================================================================
# SMART AGRICULTURE ROVER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Default Device & Farm Identifiers
DEFAULT_DEVICE_ID=rover-001
DEFAULT_FARM_ID=farm-001
DEFAULT_PLOT_ID=plot-001

# MQTT Broker Configuration
# Standard public brokers for testing:
#   - mqtt://broker.emqx.io:1883
#   - mqtt://test.mosquitto.org:1883
# For local Mosquitto broker:
#   - mqtt://127.0.0.1:1883
# For secure TLS broker:
#   - mqtts://your-broker-url:8883
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_CLIENT_ID=agri-rover-backend-server
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_RECONNECT_PERIOD=5000

# Telemetry & Status Settings
ROVER_OFFLINE_THRESHOLD_SECONDS=15
SIMULATED_DATA_ENABLED=true

# Database Path
DB_PATH=../agri_rover.db
