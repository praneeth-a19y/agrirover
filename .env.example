# ==============================================================================
# SMART AGRICULTURE ROVER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in the backend folder and adjust parameters as needed.
# ==============================================================================

# Server configuration
APP_NAME="Smart Agriculture Rover API"
VERSION="1.0.0"
API_PREFIX="/api/v1"
DATABASE_URL="sqlite:///./agri_rover.db"

# Storage
UPLOAD_DIR="./app/static/uploads"

# Machine Learning Offline Model Path (Optional - defaults to heuristic if file not present)
MODEL_PATH="./models/crop_disease_model.tflite"
MODEL_VERSION="v1.2.0-mobilenetv2"

# Rover Hardware Watchdog Settings
DEFAULT_DEVICE_ID="rover-001"
ROVER_OFFLINE_THRESHOLD_SECONDS=45
COMMAND_TIMEOUT_SECONDS=15
MAX_MOVEMENT_DURATION_MS=5000

# Default Alert Thresholds
MOISTURE_MIN_PERCENT=30.0
MOISTURE_MAX_PERCENT=80.0
PH_MIN=6.0
PH_MAX=7.5
TEMP_MIN_C=12.0
TEMP_MAX_C=38.0
HUMIDITY_MIN_PERCENT=30.0
HUMIDITY_MAX_PERCENT=85.0
DISEASE_CONFIDENCE_ALERT=0.70

# Demonstration Mode
DEMO_MODE_DEFAULT=false
