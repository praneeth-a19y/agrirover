# ==============================================================================
# AGRIROVER — ENVIRONMENT CONFIGURATION (RENDER & EMQX CLOUD)
# ==============================================================================

# Server Network Configuration (Render automatically sets PORT in production)
PORT=8000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_ORIGIN=*

# Default IoT Device Identifiers
DEVICE_ID=agrirover-01
DEFAULT_DEVICE_ID=agrirover-01
DEFAULT_FARM_ID=farm-001
DEFAULT_PLOT_ID=plot-001

# EMQX Cloud Serverless MQTT Broker (TLS Port 8883)
MQTT_HOST=ed61a166.ala.eu-central-1.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_CLIENT_ID=agrirover-backend
MQTT_CA_CERT=certs/emqx-ca.pem
MQTT_KEEPALIVE=60
MQTT_RECONNECT_PERIOD=5000

# Telemetry & Status Settings
ROVER_OFFLINE_THRESHOLD_SECONDS=20
SIMULATED_DATA_ENABLED=false

# SQLite Database Path
DB_PATH=../agri_rover.db
